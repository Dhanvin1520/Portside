    "@portside/control-plane": "*",
    "fast-check": "^3.15.1"
  },
  "devDependencies": {
    "vitest": "^1.2.0",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0"
  }
}
